{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "findings",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "severity", "category", "code", "evidence", "target_stage"],
    "properties": {
      "id": {"type": "string"},
      "severity": {"enum": ["high", "medium", "low"]},
      "category": {"enum": ["accounting", "geography", "statistics", "adversarial", "continuity", "contract"]},
      "code": {"type": "string"},
      "rows": {"type": "array", "items": {"type": "string"}},
      "evidence": {"type": "string", "minLength": 8},
      "fix_hint": {"type": "string"},
      "target_stage": {"enum": ["director", "solver", "cast", "renderer"]}
    }
  }
}
