{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ledger-month",
  "type": "object",
  "required": ["month", "begin_cents", "end_cents", "rows"],
  "properties": {
    "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "begin_cents": {"type": "integer"},
    "end_cents": {"type": "integer"},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "kind", "direction", "amount_cents", "balance_cents"],
        "properties": {
          "id": {"type": "string"},
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "time": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"},
          "kind": {"type": "string"},
          "merchant_class": {"type": "string"},
          "merchant": {"type": "string"},
          "store_no": {"type": "string", "pattern": "^[0-9]{3,4}$"},
          "place": {"type": ["object", "null"]},
          "direction": {"enum": ["debit", "credit"]},
          "amount_cents": {"type": "integer", "minimum": 1},
          "balance_cents": {"type": "integer"},
          "event_id": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
