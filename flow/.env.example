# LLM proxy (OpenAI-compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-6.1-sol
# json_schema | function_calling | json_mode
LLM_STRUCTURED_MODE=json_schema

# Web search
TAVILY_API_KEY=

# Server
API_KEY=
BANK_DISPLAY_NAME=Harborline Bank
DATABASE_PATH=./data/app.db
HOST=127.0.0.1
PORT=8797

# billgen (Python) — leave BILLGEN_MCP_CMD empty to generate statements without rendering PDFs
BILLGEN_MCP_CMD=../.venv/bin/billgen
# Comma-separated template ids, or "auto" to let the recommender pick (see docs/m10-pool-and-auto-templates.md).
BILLGEN_TEMPLATES=auto
# How many recommendations to keep per account when the list contains "auto"
BILLGEN_AUTO_LIMIT=2
BILLGEN_OUT=./data/renders
# 1 = let the model edit the template data; 0 = render the deterministic ledger draft
BILLGEN_AI_FILL=1
