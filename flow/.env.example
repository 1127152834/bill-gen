# LLM proxy (OpenAI-compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-6.1-sol
# json_schema | function_calling | json_mode
LLM_STRUCTURED_MODE=json_schema

# Web search
TAVILY_API_KEY=

# Server
API_KEY=
# 行名不用配：账单印的就是所选模板自带的那家银行（BOA/Chase/Wells Fargo…）
DATABASE_PATH=./data/app.db
HOST=127.0.0.1
PORT=8797

# billgen (Python) — leave BILLGEN_MCP_CMD empty to generate statements without rendering PDFs
BILLGEN_MCP_CMD=../.venv/bin/billgen
# Comma-separated template ids, or "auto" to let the recommender pick (see docs/m10-pool-and-auto-templates.md).
BILLGEN_TEMPLATES=auto
# How many recommendations to keep per account when the list contains "auto"
BILLGEN_AUTO_LIMIT=2
BILLGEN_OUT=./data/renders
# 1 = 草稿不合格才让模型补（默认，快）；always = 每次让模型改；0 = 不让模型碰
BILLGEN_AI_FILL=1

# 生成进度按行打到 stdout（默认开）；LOG_RESEARCH=1 连每次检索明细一起打
LOG_PROGRESS=1
LOG_RESEARCH=0
# 每条检索的并发数（默认 8，上限 16）
RESEARCH_CONCURRENCY=8

# 分节点模型覆盖：只改需要加速的那一步，其余沿用 LLM_MODEL（留空=不覆盖）
# lifeModel 是一次长输出，换快一点的模型收益最大；audit 短而重推理，通常保持默认
# LLM_MODEL_LIFEMODEL=
# LLM_MODEL_DESCRIPTORS=
# LLM_MODEL_AUDIT=
# LLM_MODEL_PLANRESEARCH=
