{
  "theme": "mercury",
  "why": "Mercury 个人/企业同一个版式：卡消费只印商户名，不带城市与卡尾；ACH 只印对方名，不带 PAYMENT 尾巴。",
  "kind": "deposit",
  "columns": [
    "date",
    "description",
    "type",
    "amount",
    "balance"
  ],
  "type_enum": [
    "Card",
    "ACH Out",
    "ACH In"
  ],
  "type_aliases": {
    "Card Purchase": "Card",
    "ACH Debit": "ACH Out",
    "ACH Credit": "ACH In",
    "DEBIT": "Card",
    "ACH": "ACH Out"
  },
  "descriptor": {
    "card": {
      "template": "{merchant}",
      "rules": [
        "no_city",
        "no_card_tail",
        "upper"
      ],
      "max_len": 42
    },
    "ach": {
      "template": "{payee}",
      "rules": [
        "upper",
        "no_payment_tail"
      ],
      "max_len": 42
    },
    "atm": {
      "template": "ATM WITHDRAWAL {city} {state}",
      "rules": [
        "upper"
      ],
      "max_len": 42
    }
  },
  "row_rules": {
    "amount_decimals": 2,
    "date_format": "%b %-d",
    "balance_chain": true
  },
  "forbidden_literals": [
    "SAMPLE",
    "billgen",
    "PyMuPDF",
    "Bank of America",
    "Lorem"
  ],
  "evidence": [
    "src/billgen/themes/mercury/Demo-Bank-Statement-SAMPLE.pdf#p1",
    "src/billgen/synth/line_styles.py#mercury_desc"
  ],
  "card_types": [
    "Card"
  ],
  "type_column": true
}
