    },
    "ach": {
      "template": "{payee}",
      "rules": [
        "upper",
        "no_payment_tail"
      ],
      "max_len": 42
    },
    "atm": {
      "template": "ATM WITHDRAWAL {city} {state}",
      "rules": [
        "upper"
      ],
      "max_len": 42
    }
  },
  "card_tail": false,
  "row_rules": {
    "amount_decimals": 2,
    "date_format": "%b %-d",
    "balance_chain": true
  },
